# Aucune clé n'est nécessaire pour le mode gratuit.
PORT=10000
# Le mode serveur persiste seulement les données fictives de la démo.
DATA_FILE=./data/database.json
ENABLE_DEMO_RESET=true

# FACULTATIF : mode streaming (services externes, coûts/crédits selon vos comptes).
# Ne pas utiliser ces clés dans GitHub Pages ou dans public/.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar-TN
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Les sessions streaming sont plafonnées à 10 minutes côté serveur.
STREAM_MAX_MINUTES=10
